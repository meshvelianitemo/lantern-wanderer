extends Node
## Music, ambience, sound effects and character voices (autoload "Sound").
##   Sound.music("glimmerdeep")        crossfade to a looping track ("" = fade to silence)
##   Sound.ambience("cave")            crossfade to a looping ambience bed ("" = none)
##   Sound.sfx("ember")                one-shot effect with a slight random pitch
##   Sound.sfx_at("shade_near", pos)   the same, placed in the 2D world (fades with distance)
##   Sound.voice("tallow")             one spoken syllable (Dialogue calls this while typing)
##   Sound.speak("Nan Tallow")         same, but takes a speaker's display name
##   Sound.set_volume("Music", 0.8)    bus volume, linear 0..1 (Music, Ambience, SFX, Voice)
## Files are generated by art_src/audio.py into res://assets/audio/:
##   music/<id>.ogg  ambience/<id>.ogg  sfx/<id>.wav  voice/<id>_<n>.wav
## Any missing file is silently ignored, so the game runs without audio too.

const ROOT := "res://assets/audio/"
const EXTENSIONS := [".ogg", ".wav", ".mp3"]
## Bus name -> default volume (dB). Buses are created at startup if missing.
const BUSES := {"Music": -4.0, "Ambience": -6.0, "SFX": -3.0, "Voice": -4.0}
## Tracks that play once instead of looping.
const NON_LOOPING := ["ending", "first_page"]
## How far the music dips while a dialogue box is open.
const DUCK_DB := -6.0
## Minimum seconds between two syllables of one voice (slow speakers talk slower).
const VOICE_GAP := {
	"mossback": 0.12, "gudgeon": 0.15, "rootmother": 0.15, "hollow_one": 0.13, "archivist": 0.09,
	"ash": 0.08, "pell": 0.045, "sprig": 0.05, "burrow": 0.06, "narration": 0.05, "orrin": 0.1,
	"lark": 0.075, "maud": 0.08, "vesper": 0.1, "edda": 0.11, "keeper": 0.055, "glim": 0.09,
}
const VOICE_GAP_DEFAULT := 0.07
const VOICE_PITCH_JITTER := 0.05
## Display name -> voice id (anything else falls back to the lower-cased name).
const SPEAKER_VOICES := {
	"": "narration", "Mossback": "mossback", "Nan Tallow": "tallow", "Tallow": "tallow",
	"Pell": "pell", "Burrow": "burrow", "Wisp": "wisp", "Ash": "ash",
	"The Archivist": "archivist", "Archivist": "archivist", "Bell": "bell",
	"Old Gudgeon": "gudgeon", "Gudgeon": "gudgeon", "The Root-Mother": "rootmother",
	"Root-Mother": "rootmother", "Sprig": "sprig", "The Hollow One": "hollow_one", "Hollow One": "hollow_one",
	"Orrin": "orrin",
	"Lark": "lark", "Maud": "maud", "Vesper": "vesper", "Edda": "edda", "Glim": "glim",
	"Hollis": "keeper", "Fitch": "keeper", "Tobin": "keeper", "Pim": "keeper", "Wren": "keeper",
}

## Debug (--sfxlog): print every effect played, marking those during dialogue.
var log_sfx := false

var _music_id := ""
var _ambience_id := ""
var _music_layers: Array[Dictionary] = []
var _ambience_layers: Array[Dictionary] = []
var _duck := 0.0
var _cache := {}
var _last_sfx := {}
var _voice_sets := {}
var _voice_players := {}
var _voice_turn := {}
var _voice_last := {}
var _voice_prev := {}


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_setup_buses()


# --- public API ------------------------------------------------------------

func music(id: String, fade := 1.5) -> void:
	if id == _music_id:
		return
	_music_id = id
	var stream := _load_stream("music/" + id, not id in NON_LOOPING) if id != "" else null
	_crossfade(_music_layers, "Music", stream, fade)


func ambience(id: String, fade := 1.5) -> void:
	if id == _ambience_id:
		return
	_ambience_id = id
	var stream := _load_stream("ambience/" + id, true) if id != "" else null
	_crossfade(_ambience_layers, "Ambience", stream, fade)


func current_music() -> String:
	return _music_id


func sfx(id: String, volume_db := 0.0, pitch := 1.0) -> void:
	var stream := _sfx_stream(id)
	if stream == null:
		return
	var p := AudioStreamPlayer.new()
	p.bus = "SFX"
	p.stream = stream
	p.volume_db = volume_db
	p.pitch_scale = pitch * randf_range(0.96, 1.04)
	add_child(p)
	p.play()
	p.finished.connect(p.queue_free)


func sfx_at(id: String, world_pos: Vector2, volume_db := 0.0, pitch := 1.0) -> void:
	var stream := _sfx_stream(id)
	if stream == null:
		return
	var p := AudioStreamPlayer2D.new()
	p.bus = "SFX"
	p.stream = stream
	p.volume_db = volume_db
	p.pitch_scale = pitch * randf_range(0.96, 1.04)
	p.max_distance = 420.0
	p.attenuation = 1.6
	add_child(p)
	p.global_position = world_pos
	p.play()
	p.finished.connect(p.queue_free)


func voice(id: String) -> void:
	if id == "":
		return
	var now := Time.get_ticks_msec() / 1000.0
	if now - float(_voice_last.get(id, -10.0)) < float(VOICE_GAP.get(id, VOICE_GAP_DEFAULT)):
		return
	var set := _voice_set(id)
	if set.is_empty():
		return
	_voice_last[id] = now
	if not _voice_players.has(id):
		var pair: Array[AudioStreamPlayer] = []
		for i in 2:
			var vp := AudioStreamPlayer.new()
			vp.bus = "Voice"
			add_child(vp)
			pair.append(vp)
		_voice_players[id] = pair
	# Two players per voice: the newest syllable cuts off the one before the
	# previous, so tails (echoes, sighs) still overlap but never pile up.
	var turn: int = (int(_voice_turn.get(id, 0)) + 1) % 2
	_voice_turn[id] = turn
	var p: AudioStreamPlayer = _voice_players[id][turn]
	var pick := randi() % set.size()
	if set.size() > 1 and pick == int(_voice_prev.get(id, -1)):
		pick = (pick + 1 + randi() % (set.size() - 1)) % set.size()
	_voice_prev[id] = pick
	p.stop()
	p.stream = set[pick]
	p.pitch_scale = 1.0 + randf_range(-VOICE_PITCH_JITTER, VOICE_PITCH_JITTER)
	p.play()


func voice_for(who: String) -> String:
	if SPEAKER_VOICES.has(who):
		return SPEAKER_VOICES[who]
	return who.to_lower().replace(" ", "_").replace("-", "")


func speak(who: String) -> void:
	voice(voice_for(who))


func has_voice(id: String) -> bool:
	return not _voice_set(id).is_empty()


func set_volume(bus: String, linear: float) -> void:
	var i := AudioServer.get_bus_index(bus)
	if i >= 0:
		AudioServer.set_bus_volume_db(i, linear_to_db(maxf(linear, 0.0001)) + float(BUSES.get(bus, 0.0)))


func get_volume(bus: String) -> float:
	var i := AudioServer.get_bus_index(bus)
	if i < 0:
		return 1.0
	return db_to_linear(AudioServer.get_bus_volume_db(i) - float(BUSES.get(bus, 0.0)))


func stop_all(fade := 1.0) -> void:
	music("", fade)
	ambience("", fade)


# --- internals ---------------------------------------------------------------

func _process(delta: float) -> void:
	var dialogue := get_node_or_null("/root/Dialogue")
	var talking: bool = dialogue != null and "active" in dialogue and dialogue.active
	_duck = move_toward(_duck, DUCK_DB if talking else 0.0, delta * 12.0)
	_update_layers(_music_layers, delta, _duck)
	_update_layers(_ambience_layers, delta, 0.0)


func _crossfade(layers: Array[Dictionary], bus: String, stream: AudioStream, fade: float) -> void:
	var rate := 1.0 / maxf(fade, 0.01)
	for l in layers:
		l["target"] = 0.0
		l["rate"] = rate
	if stream == null:
		return
	var p := AudioStreamPlayer.new()
	p.bus = bus
	p.stream = stream
	p.volume_db = -80.0
	add_child(p)
	p.play()
	layers.append({"player": p, "gain": 0.0, "target": 1.0, "rate": rate})


func _update_layers(layers: Array[Dictionary], delta: float, extra_db: float) -> void:
	for i in range(layers.size() - 1, -1, -1):
		var l := layers[i]
		l["gain"] = move_toward(l["gain"], l["target"], l["rate"] * delta)
		var p: AudioStreamPlayer = l["player"]
		p.volume_db = linear_to_db(maxf(l["gain"], 0.0001)) + extra_db
		if l["gain"] <= 0.0 and l["target"] <= 0.0:
			p.queue_free()
			layers.remove_at(i)


func _sfx_stream(id: String) -> AudioStream:
	# the same effect fired many times in one instant only plays once
	var now := Time.get_ticks_msec()
	if now - int(_last_sfx.get(id, -1000)) < 30:
		return null
	var stream := _load_stream("sfx/" + id, false)
	if stream:
		_last_sfx[id] = now
		if log_sfx:
			print("sfx %-14s %s" % [id, "DURING DIALOGUE" if Game.in_dialogue else ""])
	return stream


func _voice_set(id: String) -> Array:
	if not _voice_sets.has(id):
		var set: Array[AudioStream] = []
		for n in 16:
			var s := _load_stream("voice/%s_%d" % [id, n], false)
			if s == null:
				break
			set.append(s)
		_voice_sets[id] = set
	return _voice_sets[id]


func _load_stream(rel: String, loop: bool) -> AudioStream:
	var key := rel + ("#loop" if loop else "")
	if _cache.has(key):
		return _cache[key]
	var stream: AudioStream = null
	for ext: String in EXTENSIONS:
		var path := ROOT + rel + ext
		if ResourceLoader.exists(path):
			stream = load(path)
			break
	if stream:
		_set_loop(stream, loop)
	_cache[key] = stream
	return stream


func _set_loop(stream: AudioStream, loop: bool) -> void:
	if stream is AudioStreamOggVorbis:
		(stream as AudioStreamOggVorbis).loop = loop
	elif stream is AudioStreamMP3:
		(stream as AudioStreamMP3).loop = loop
	elif stream is AudioStreamWAV:
		var w := stream as AudioStreamWAV
		if loop:
			w.loop_mode = AudioStreamWAV.LOOP_FORWARD
			w.loop_begin = 0
			w.loop_end = int(w.get_length() * w.mix_rate)
		else:
			w.loop_mode = AudioStreamWAV.LOOP_DISABLED


func _setup_buses() -> void:
	for bus: String in BUSES:
		var i := AudioServer.get_bus_index(bus)
		if i == -1:
			AudioServer.add_bus()
			i = AudioServer.bus_count - 1
			AudioServer.set_bus_name(i, bus)
			AudioServer.set_bus_send(i, "Master")
		AudioServer.set_bus_volume_db(i, BUSES[bus])
	# a little shared space around voices and effects
	_add_reverb("Voice", 0.3, 0.12)
	_add_reverb("SFX", 0.4, 0.07)
	var master := AudioServer.get_bus_index("Master")
	if AudioServer.get_bus_effect_count(master) == 0 and ClassDB.class_exists("AudioEffectHardLimiter"):
		var lim: AudioEffect = ClassDB.instantiate("AudioEffectHardLimiter")
		lim.set("ceiling_db", -0.5)
		AudioServer.add_bus_effect(master, lim)


func _add_reverb(bus: String, room: float, wet: float) -> void:
	var i := AudioServer.get_bus_index(bus)
	if i < 0 or AudioServer.get_bus_effect_count(i) > 0:
		return
	var r := AudioEffectReverb.new()
	r.room_size = room
	r.damping = 0.6
	r.spread = 0.6
	r.wet = wet
	r.dry = 1.0
	r.predelay_msec = 20.0
	AudioServer.add_bus_effect(i, r)
